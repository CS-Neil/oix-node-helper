#!/bin/sh

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/scan-secrets.ps1 -Staged
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/scan-secrets.ps1 -Staged
fi

echo "Secret scan failed: PowerShell 7 or Windows PowerShell was not found." >&2
exit 1
